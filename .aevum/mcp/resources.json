{
  "version": "2.0.0",
  "resources": [
    {
      "id": "index",
      "uri": "aevum://context/index.json",
      "name": "Project Index",
      "description": "Project structure, domains, features, and plans",
      "mimeType": "application/json"
    },
    {
      "id": "memory",
      "uri": "aevum://context/global/memory.md",
      "name": "Global Memory",
      "description": "Global memory and context shared across sessions",
      "mimeType": "text/markdown"
    },
    {
      "id": "persona",
      "uri": "aevum://context/global/companion_persona.json",
      "name": "Companion Persona",
      "description": "Active companion AI persona configuration",
      "mimeType": "application/json"
    },
    {
      "id": "session",
      "uri": "aevum://context/session.json",
      "name": "Session Snapshot",
      "description": "Real-time editor session context and reasoning",
      "mimeType": "application/json"
    },
    {
      "id": "current_plan",
      "uri": "aevum://context/current_plan.json",
      "name": "Active Plan Context",
      "description": "The plan currently assigned and being executed",
      "mimeType": "application/json"
    },
    {
      "id": "health",
      "uri": "aevum://health/status",
      "name": "System Health",
      "description": "Real-time system health and performance diagnostics",
      "mimeType": "application/json"
    },
    {
      "id": "research-node",
      "uri": "aevum://research/nodes/{nodeId}",
      "name": "Research Node Specification",
      "description": "Chi tiết node tri thức RDD kèm bằng chứng, công thức hoặc sandbox test",
      "mimeType": "application/json"
    },
    {
      "id": "research-paper",
      "uri": "aevum://research/papers/{paperFile}",
      "name": "Research Whitepaper",
      "description": "Toàn văn bài báo chuyên khảo nguyên tử trong .aevum/research/",
      "mimeType": "text/markdown"
    }
  ],
  "prompts": [
    {
      "id": "plan_execution",
      "name": "Plan Execution",
      "description": "Guidance for executing an Aevum plan step-by-step",
      "arguments": [
        {
          "name": "planPath",
          "description": "Path to the plan file",
          "required": true
        }
      ]
    },
    {
      "id": "research_mission",
      "name": "Deep Research Mission",
      "description": "Autonomous recursive deep research exploration",
      "arguments": [
        {
          "name": "topic",
          "description": "Research topic",
          "required": true
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "Bridge Lifecycle",
      "description": "Quản lý vòng đời kết nối bridge, bootstrap và handshake tín hiệu hệ thống (bootstrap, ack, connect, ping, disconnect).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "bootstrap",
              "ack",
              "connect",
              "ping",
              "disconnect"
            ]
          },
          "signalId": {
            "type": "string"
          },
          "client": {
            "type": "string"
          },
          "projectPath": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "Session Lifecycle",
      "description": "Quản lý phiên làm việc: khởi tạo session, nộp báo cáo thực thi (report) và bằng chứng (evidence), nghiệm thu và đóng phiên.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "submit_report",
              "add_evidence",
              "finalize",
              "get_status"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "projectPath": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "Persona Manage",
      "description": "Quản trị nhân cách (Persona): chuyển đổi, khởi tạo danh tính, tinh chỉnh năng lượng (vibe) hoặc xem hồ sơ.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "init",
              "switch",
              "get_active",
              "list",
              "tune_vibe"
            ]
          },
          "personaId": {
            "type": "string"
          },
          "client": {
            "type": "string"
          },
          "vibe": {
            "type": "string"
          },
          "projectPath": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "Semantic Vault",
      "description": "Kho lưu trữ ngữ nghĩa: nén văn bản, trích xuất quy tắc nén (agent_rules.md) hoặc giải mã tri thức rút gọn.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "get_compressed",
              "compress_text",
              "decompress_text",
              "list_vault"
            ]
          },
          "target": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "Architecture Inspect",
      "description": "Chẩn đoán 7 Living Organs O-DDD, đo lường sinh tồn (vitality), hoặc trích xuất cây cấu trúc và bản vẽ Mermaid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "reCook": {
            "type": "string"
          },
          "projectPath": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "name": "Structure Design",
      "description": "Thiết kế và cấu trúc hóa hệ thống: tạo mới, gợi ý, đổi tên hoặc xóa Domain, Feature, Plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "suggest",
              "rename",
              "delete"
            ]
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "domainId": {
            "type": "string"
          },
          "featureId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "researchTopic": {
            "type": "string"
          },
          "newName": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "projectPath": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "Plan Lifecycle",
      "description": "Điều phối vòng đời thực thi kế hoạch: đồng bộ từ IDE, kích hoạt và khóa ranh giới file (activeFiles), cập nhật tiến độ từng bước, và nghiệm thu hoàn tất.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "activate",
              "sync",
              "update_step",
              "finalize",
              "assign",
              "mark_done"
            ]
          },
          "domainId": {
            "type": "string"
          },
          "planName": {
            "type": "string"
          },
          "featureId": {
            "type": "string"
          },
          "activeFiles": {
            "type": "string"
          },
          "stepMatch": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "sourceFilePath": {
            "type": "string"
          },
          "planTitle": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "projectPath": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "Boundary Guard",
      "description": "Kiểm soát ranh giới Bounded Context Clean Architecture, kiểm định tính toàn vẹn thư mục (sanity check), phân tích nợ kỹ thuật và sao lưu an toàn.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "audit_boundary",
