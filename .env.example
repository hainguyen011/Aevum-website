# Google Sheets Apps Script Web App URL
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# Resend API Key
RESEND_API_KEY=re_your_resend_api_key

# Verified Sender Email Address
RESEND_FROM_EMAIL=Aevum Dev Team <dev@aevum.ai.vn>

# GitHub Personal Access Token (PAT) with Read-Only permissions for Aevum-OS private repository releases
VITE_GITHUB_TOKEN=github_pat_your_github_token

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Aevum Cloud Backend API Endpoint
VITE_AEVUM_CLOUD_URL=https://api.aevum.ai.vn
