    {
      "name": "Switch Workspace",
      "description": "Chuyển đổi không gian làm việc Aevum OS sang một thư mục dự án khác một cách linh hoạt.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectPath": {
            "type": "string"
          }
        },
        "required": []
